# Copy to .env.local for the optional local Express API.
# Use the SAME project and public key as the frontend. No service-role key needed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
PORT=8000
# Kroger OAuth credentials stay on the server. On Vercel, set these same
# variable names in Project Settings > Environment Variables, then redeploy.
# KROGER_CLIENT_ID=replace_me
# KROGER_CLIENT_SECRET=replace_me
# Used by community data requests and the weekly-ad collectors. Set a real
# contact URL/email before public deployment; this value stays server-side.
# OPEN_DATA_USER_AGENT=PricePantry/1.0 (https://your-app.example/contact)
# Local development can omit SUPABASE_* above when the frontend .env.local
# already contains the same public Auth settings. Explicit server values win.
HOST=127.0.0.1
PUSH_CHECK_INTERVAL_SECONDS=60
# Optional; defaults to packages/express-backend/.local/notifications.
# PUSH_DATA_DIR=C:/private/price-pantry-notifications
# Use a real contact address before sharing/deploying the backend.
VAPID_SUBJECT=mailto:you@example.com
# VAPID keys are generated automatically and kept in the ignored local directory.
# To supply your own pair, configure BOTH VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY.
