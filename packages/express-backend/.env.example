# Price Pantry ingestion config. Copy to .env and fill in.
# .env is gitignored; never commit real keys.

# Kroger public API credentials (free: https://developer.kroger.com).
# Create an app, then copy its client id and secret here.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Supabase. The SERVICE ROLE key can write and must stay server-side
# only (never ship it to the React app, which uses the anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# What and where to search. Defaults shown; override as needed.
# INGEST_ZIP=93401
# INGEST_RADIUS_MILES=10
# INGEST_MAX_STORES=6
# INGEST_TERMS=bananas,milk 2%,large eggs,whole wheat bread,peanut butter,spinach
# INGEST_PER_TERM_LIMIT=5
# INGEST_CONCURRENCY=4

# Optional fixed distance origin (else the store centroid is used).
# INGEST_ORIGIN_LAT=35.2828
# INGEST_ORIGIN_LNG=-120.6596
