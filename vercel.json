{
  "installCommand": "npm install",
  "buildCommand": "npm run build -w react-frontend",
  "outputDirectory": "packages/react-frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/ingest",
      "schedule": "0 9 * * *"
    }
  ]
}
